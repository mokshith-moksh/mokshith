{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    // 👇 ADD THIS (from your former jsconfig)
    "baseUrl": ".",
    "paths": {
      "#components/*": ["src/components/*"],
      "#constants/*": ["src/constants/*"],
      "#store/*": ["src/store/*"],
      "#hoc/*": ["src/hoc/*"],
      "#windows/*": ["src/windows/*"]
    }
  },
  "include": ["src"]
}
